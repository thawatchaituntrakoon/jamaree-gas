# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจากโปรเจกต์ Supabase
# (Settings → API) — ห้าม commit ไฟล์ .env.local เข้า git

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ใช้ "anon / publishable key" เท่านั้น
# ห้ามใส่ service_role key ในฝั่งเว็บเด็ดขาด เพราะจะข้าม RLS ทั้งหมด
VITE_SUPABASE_ANON_KEY=your-anon-key-here
