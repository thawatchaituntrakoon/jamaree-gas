# เว็บโรงบรรจุแก๊ส JAMAREE GAS — ตัวรับ-ส่งหน้าบ้าน (reverse proxy)
#
# ตั้ง DOMAIN ใน .env.local เป็นโดเมน DuckDNS (เช่น jamaree.duckdns.org)
# → Caddy จะขอใบรับรอง Let's Encrypt ให้เองอัตโนมัติ และต่ออายุให้ตลอด
# ไม่ได้ตั้ง DOMAIN → เปิดแบบ http ตามเดิม (เข้าผ่านไอพีได้เหมือนเดิม)

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy jamaree-frontend:80
}
